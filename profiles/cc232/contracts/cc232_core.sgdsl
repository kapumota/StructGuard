package cc232;

structure ArrayStack {
  invariant n >= 0;
  invariant n <= capacity();
  method add { requires 0 <= i && i <= n; ensures n == old(n) + 1; }
  method remove { requires 0 <= i && i < n; ensures n == old(n) - 1; }
  method get requires 0 <= i && i < n;
  method set requires 0 <= i && i < n;
}

structure ArrayQueue {
  invariant n >= 0;
  invariant n <= capacity();
  invariant j >= 0;
  invariant j < capacity();
  method add { requires n < capacity(); ensures n == old(n) + 1; }
  method remove { requires n > 0; ensures n == old(n) - 1; }
}

structure ArrayDeque {
  invariant n >= 0;
  invariant n <= capacity();
  invariant j >= 0;
  invariant j < capacity();
  method add { requires 0 <= i && i <= n; ensures n == old(n) + 1; }
  method remove { requires 0 <= i && i < n; ensures n == old(n) - 1; }
}

structure *Stack {
  invariant n >= 0;
  method pop requires n > 0;
  method remove requires n > 0;
}
